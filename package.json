{
  "name": "fpt-lost-and-found",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FPT Lost & Found — authenticated campus lost-and-found application.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run test:db && npm run test:frontend",
    "test:db": "node --test tests/database.test.mjs tests/concurrency.test.mjs",
    "test:frontend": "vitest run",
    "db:types": "node scripts/generate-db-types.mjs",
    "seed:demo": "node --env-file=.env.demo.local scripts/seed-demo.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.45",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
